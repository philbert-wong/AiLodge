# Copy this file to .env for local runs. Never commit .env.

# Master secret. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SIGNING_SECRET=

# Password for the dashboard
ADMIN_PASSWORD=

# Optional: real OpenAI calls. Leave blank to use only the free fake upstream.
OPENAI_API_KEY=
OPENAI_MODEL=

# Optional: prices in USD per 1M tokens for your model (from OpenAI's pricing page)
# PRICE_INPUT_PER_1M=0.15
# PRICE_OUTPUT_PER_1M=0.60

# Hard ceiling on real OpenAI spend across all tokens
GLOBAL_REAL_BUDGET_USD=1.00

# Leave unset locally to use SQLite (leash.db). Render sets this to Postgres.
# DATABASE_URL=
